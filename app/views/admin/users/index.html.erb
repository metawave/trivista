<% content_for :title, "Users" %>
<main class="page">
  <div>
    <h1>Users</h1>
    <p class="page-head__sub">Signed in via OIDC. Groups come from the identity provider.</p>
  </div>

  <div class="panel table-scroll">
    <table class="table">
      <thead><tr><th>Name</th><th>Groups</th><th>Role</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="<%= "muted" if user.deactivated? %>">
            <td><strong><%= user.name || user.sub %></strong></td>
            <td><span class="filter-group"><% user.groups.each do |group| %><span class="chip chip--fill"><%= group %></span><% end %></span></td>
            <td>
              <% if user.admin? %><span class="badge badge--admin">ADMIN</span><% end %>
              <% if user.break_glass? %><span class="badge badge--outline">BREAK-GLASS</span><% end %>
            </td>
            <td><span class="status <%= "status--off" if user.deactivated? %>"><%= user.deactivated? ? "deactivated" : "active" %></span></td>
            <td class="num">
              <% if user.deactivated? %>
                <%= button_to "Reactivate", reactivate_admin_user_path(user), method: :patch, class: "btn btn--small" %>
              <% elsif !user.break_glass? %>
                <%= button_to "Deactivate", deactivate_admin_user_path(user), method: :patch, class: "btn btn--small btn--danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
