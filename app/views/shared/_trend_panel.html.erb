<%# locals: (note:, path:, compact: false) %>
<section class="panel trend">
  <div class="panel__head">
    <div>
      <h2><%= @trend_type.pluralize.capitalize %> over time</h2>
      <span class="note"><%= note %></span>
    </div>
    <div class="filter-group">
      <%= render "shared/severity_legend" unless compact %>
      <div class="segmented" role="group" aria-label="Finding type">
        <% Finding::TYPES.each do |finding_type| %>
          <%= link_to finding_type.pluralize.capitalize, path.call(trend: finding_type, range: @range), aria: { current: (finding_type == @trend_type).to_s } %>
        <% end %>
      </div>
      <div class="segmented" role="group" aria-label="Range">
        <% ProjectsController::RANGES.each_key do |range| %>
          <%= link_to (range == "all" ? "All" : "#{range}d"), path.call(trend: @trend_type, range:), aria: { current: (range == @range).to_s } %>
        <% end %>
      </div>
    </div>
  </div>
  <% if @trend.any? %>
    <div class="chart <%= "chart--compact" if compact %>" data-controller="trend"
         data-trend-points-value="<%= @trend.map { { label: it.day.strftime("%b %-d"), counts: it.counts } }.to_json %>"
         data-trend-severities-value="<%= Occurrence::SEVERITIES.to_json %>">
      <canvas data-trend-target="canvas" aria-label="Findings per day by severity" role="img"></canvas>
    </div>
  <% else %>
    <p class="empty muted">No scans on the Default Branches yet.</p>
  <% end %>
</section>
