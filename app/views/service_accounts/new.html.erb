<% content_for :title, "New service account" %>
<main class="page page--form">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <%= link_to "Service accounts", service_accounts_path %><span aria-hidden="true">/</span><span aria-current="page">New</span>
  </nav>
  <h1>New service account</h1>

  <%= form_with model: @service_account, class: "panel panel--padded form" do |form| %>
    <% @service_account.errors.full_messages.each do |message| %>
      <p class="flash flash--alert" role="alert"><%= icon(:alert) %><%= message %></p>
    <% end %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, class: "mono", aria: { invalid: @service_account.errors.include?(:name) || nil } %>
    </div>
    <div class="field">
      <%= form.label :owner %>
      <%= form.select :owner, [ [ "Me", "user" ] ] + Current.user.groups.map { [ it, "group:#{it}" ] }, selected: params.dig(:service_account, :owner) %>
      <span class="field__hint">With a group owner, every group member manages its tokens.</span>
    </div>
    <div class="form-row">
      <%= form.submit "Create", class: "btn btn--primary" %>
      <%= link_to "Cancel", service_accounts_path, class: "btn" %>
    </div>
  <% end %>
</main>
