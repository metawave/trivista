<%# locals: (rows:, total:, type_label:, origin_header: nil, origin: nil) %>
<section class="panel panel--dashed" id="no-longer-reported">
  <div class="panel__head panel__head--stack">
    <h2 class="with-icon title-muted">No longer reported <span class="count"><%= rows.size %></span></h2>
    <span class="note">
      <%= type_label %> not reported compared to the previous scan<%= " (#{total} across all types)" if total != rows.size %>.
      This does not necessarily mean fixed; the scan configuration may have changed.
    </span>
  </div>
  <% if rows.any? %>
    <div class="table-scroll">
      <table class="table table--muted findings">
        <thead>
          <tr><th>Severity</th><th>ID</th><th>Package / Target</th><th>Installed</th><th>Fixed in</th><% if origin %><th><%= origin_header %></th><% end %><th>Title</th></tr>
        </thead>
        <tbody class="no-longer-reported">
          <%= render "scans/finding_rows", rows:, new_finding_ids: nil, gone: true, origin: %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty muted">None with these filters.</p>
  <% end %>
</section>
