<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Trivista" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Trivista">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if Current.user %>
      <header class="app-header">
        <div class="app-header__inner">
          <div class="app-header__start">
            <%= link_to root_path, class: "brand" do %><%= logo %>Trivista<% end %>
            <nav class="main-nav" aria-label="Main">
              <%= nav_link "Projects", root_path, active: controller_name.in?(%w[projects repos branches scans]) %>
              <%= nav_link "Service accounts", service_accounts_path, active: controller_name.in?(%w[service_accounts upload_tokens]) %>
              <% if Current.user.admin? %><%= nav_link "Users", admin_users_path, active: controller_name == "users" %><% end %>
            </nav>
          </div>
          <div class="app-header__end">
            <span class="user"><%= Current.user.name || Current.user.sub %></span>
            <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn--small" %>
          </div>
        </div>
      </header>
    <% end %>
    <% if flash.any? %>
      <div class="flash-area">
        <% flash.each do |type, message| %>
          <p class="flash flash--<%= type %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= icon(type == "alert" ? :alert : :notice) %><%= message %></p>
        <% end %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
