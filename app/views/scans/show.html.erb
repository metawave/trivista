<% branch = @scan.branch %>
<% content_for :title, "#{@scan.commit_sha.first(8)} · #{branch.name}" %>
<% filter_params = { type: @finding_type, severity: @severities.join(",").presence, only_new: ("1" if @only_new) } %>
<main class="page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <%= link_to "Projects", root_path %><span aria-hidden="true">/</span>
    <%= link_to branch.repo.project.name, branch.repo.project %><span aria-hidden="true">/</span>
    <%= link_to "#{branch.repo.name} @ #{branch.name}", repo_path(branch.repo, branch: branch.name), class: "mono" %><span aria-hidden="true">/</span>
    <span class="mono" aria-current="page"><%= @scan.commit_sha.first(8) %></span>
  </nav>

  <div class="page-head">
    <div class="page-head__title">
      <h1 class="page-title--mono"><%= @scan.commit_sha.first(8) %></h1>
      <% if @scan.tag %><span class="chip"><%= @scan.tag %></span><% end %>
      <span class="chip"><%= @scan.trigger %></span>
    </div>
    <% if manageable?(branch.repo.project) %>
      <%= button_to "Delete scan", scan_path(@scan), method: :delete, class: "btn btn--danger", data: { turbo_confirm: "Delete this scan?" } %>
    <% end %>
  </div>

  <div class="summary-row">
    <dl class="panel meta-grid scan-meta">
      <div><dt>Artifact</dt><dd><span class="mono"><%= @scan.artifact.name %></span> <span class="muted"><%= @scan.reported_artifact_type %></span></dd></div>
      <div><dt>Commit</dt><dd class="with-icon"><span class="mono"><%= @scan.commit_sha %></span><%= copy_button(@scan.commit_sha, label: "Copy commit") %></dd></div>
      <div><dt>Uploaded</dt><dd class="mono"><%= @scan.created_at.to_fs(:db) %></dd></div>
      <div><dt>Uploaded by</dt><dd><span class="mono"><%= @scan.service_account.name %></span> <span class="muted"><%= @scan.service_account.owner.display_name %></span></dd></div>
      <% if @scan.trivy_version %><div><dt>Trivy</dt><dd class="mono"><%= @scan.trivy_version %></dd></div><% end %>
      <div>
        <dt>Compared to</dt>
        <dd class="mono">
          <% if @diff.predecessor %>
            <span class="muted"><%= @diff.predecessor.created_at.to_fs(:db) %></span> <%= link_to @diff.predecessor.commit_sha.first(8), @diff.predecessor %>
          <% else %>
            <span class="muted">first scan</span>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if @diff.predecessor %>
      <section class="panel diff-summary" aria-label="Diff">
        <div class="diff-summary__values">
          <%= link_to scan_path(@scan, filter_params.merge(only_new: "1")), class: "is-new" do %><b>+<%= @diff.new_finding_ids.size %></b>new<% end %>
          <%= link_to "#no-longer-reported" do %><b>−<%= @diff.no_longer_reported_finding_ids.size %></b>no longer reported<% end %>
        </div>
        <span class="note">vs. predecessor <%= @diff.predecessor.commit_sha.first(8) %></span>
      </section>
    <% end %>
  </div>

  <section class="panel">
    <h2 class="visually-hidden">Findings</h2>
    <nav class="tabs" aria-label="Finding type">
      <% Finding::TYPES.each do |finding_type| %>
        <%= link_to scan_path(@scan, filter_params.merge(type: finding_type)), class: "tab", aria: { current: ("page" if finding_type == @finding_type) } do %>
          <%= finding_type.pluralize.capitalize %> <span class="count"><%= type_count(@scan.counts, finding_type) %></span>
        <% end %>
      <% end %>
    </nav>
    <div class="filters">
      <div class="filter-group" role="group" aria-label="Severity">
        <% shown = shown_severities(@severities) %>
        <% Occurrence::SEVERITIES.each do |severity| %>
          <%= link_to scan_path(@scan, filter_params.merge(severity: severity_toggle_param(@severities, severity))), class: "toggle", aria: { current: shown.include?(severity).to_s } do %>
            <span class="swatch swatch--<%= severity.downcase %>"></span><%= severity %> <%= @scan.counts.dig(@finding_type, severity).to_i %>
          <% end %>
        <% end %>
      </div>
      <% if @diff.predecessor %>
        <%= link_to scan_path(@scan, filter_params.merge(only_new: (@only_new ? nil : "1"))), class: "toggle toggle--accent", aria: { current: @only_new.to_s } do %>
          Only new
        <% end %>
      <% end %>
    </div>

    <% if @rows.any? %>
      <div class="table-scroll">
        <table class="table findings">
          <thead>
            <tr><th>Severity</th><th>ID</th><th>Package / Target</th><th>Installed</th><th>Fixed in</th><th>Title</th></tr>
          </thead>
          <tbody class="current">
            <%= render "finding_rows", rows: @rows, new_finding_ids: @new_finding_ids, gone: false %>
          </tbody>
        </table>
      </div>
      <% if @row_count > @rows.size %>
        <div class="panel__foot">Showing the first <%= @rows.size %> of <%= @row_count %>. Narrow the filters to see the rest.</div>
      <% end %>
    <% else %>
      <p class="empty muted">No findings match these filters.</p>
    <% end %>
  </section>

  <% if @diff.no_longer_reported_finding_ids.any? %>
    <%= render "no_longer_reported", rows: @no_longer_reported, total: @diff.no_longer_reported_finding_ids.size, type_label: @finding_type.pluralize.capitalize %>
  <% end %>
</main>
