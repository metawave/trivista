<h1>Projects</h1>

<table class="projects">
  <thead>
    <tr>
      <th>Project</th>
      <th>Owner</th>
      <% Finding::TYPES.each do |finding_type| %>
        <th><%= finding_type.pluralize.capitalize %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @projects.each do |project| %>
      <tr id="<%= dom_id(project) %>">
        <td><%= link_to project.name, project %></td>
        <td><%= project.owner.display_name %></td>
        <% Finding::TYPES.each do |finding_type| %>
          <td class="<%= finding_type %>"><%= severity_counts(@counts.dig(project.id, finding_type)) %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<p>Signed in as <%= Current.user.name || Current.user.sub %>.</p>
<%= button_to "Sign out", logout_path, method: :delete %>
