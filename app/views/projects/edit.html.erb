<h1><%= link_to @project.name, @project %> settings</h1>

<h2>Visibility</h2>
<%= form_with model: @project do |form| %>
  <% @project.errors.full_messages.each do |message| %>
    <p class="flash flash-alert"><%= message %></p>
  <% end %>
  <% options = (@project.owner.user? ? [ [ "Only me", "user" ] ] : []) + [ [ "Group", "group" ], [ "All signed-in users", "public" ] ] %>
  <%= form.select :visibility, options %>
  <% if @project.owner.user? %>
    <%= form.select :visibility_group, Current.user == @project.owner.user ? @project.owner.user.groups : [ @project.visibility_group ].compact, include_blank: "(group)" %>
  <% end %>
  <%= form.submit "Save" %>
<% end %>

<h2>Repos</h2>
<% @project.repos.includes(:branches).order(:name).each do |repo| %>
  <section>
    <h3><%= repo.name %></h3>
    <%= form_with model: repo do |form| %>
      <%= form.label :default_branch_id, "Default branch" %>
      <%= form.select :default_branch_id, repo.branches.sort_by(&:name).map { [ it.name, it.id ] } %>
      <%= form.submit "Set" %>
    <% end %>
    <ul>
      <% repo.branches.sort_by(&:name).each do |branch| %>
        <li>
          <%= branch.name %>
          <%= form_with url: branch_path(branch), method: :delete, class: "inline" do %>
            <%= text_field_tag :confirmation, nil, placeholder: "type #{branch.name}" %>
            <%= submit_tag "Delete branch" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= form_with url: repo_path(repo), method: :delete do %>
      <%= text_field_tag :confirmation, nil, placeholder: "type #{repo.name}" %>
      <%= submit_tag "Delete repo" %>
    <% end %>
  </section>
<% end %>

<h2>Delete project</h2>
<p>Deletes all repos, branches, scans and findings of this project.</p>
<%= form_with url: project_path(@project), method: :delete do %>
  <%= text_field_tag :confirmation, nil, placeholder: "type #{@project.name}" %>
  <%= submit_tag "Delete project" %>
<% end %>
