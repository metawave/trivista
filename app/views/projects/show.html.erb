<% content_for :title, @project.name %>
<main class="page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <%= link_to "Projects", root_path %><span aria-hidden="true">/</span><span aria-current="page"><%= @project.name %></span>
  </nav>

  <section class="panel header-card">
    <div class="header-card__field header-card__field--main">
      <span class="header-card__label">Project</span>
      <h1><%= @project.name %></h1>
      <span class="meta-line">
        <span>Owner <strong><%= @project.owner.display_name %></strong></span>
        <%= visibility_label(@project) %>
        <span><%= pluralize(@repos.size, "repo") %><% if (last = @last_scans.values.max) %> · last scan <%= time_ago_in_words(last) %> ago<% end %></span>
      </span>
    </div>
    <% if manageable?(@project) %>
      <%= link_to edit_project_path(@project), class: "btn" do %><%= icon(:settings) %>Settings<% end %>
    <% end %>
  </section>

  <nav class="tabs tabs--page" aria-label="Project view">
    <%= link_to "Overview", project_path(@project), class: "tab", aria: { current: ("page" unless @finding_type) } %>
    <% Finding::TYPES.each do |finding_type| %>
      <%= link_to project_path(@project, type: finding_type), class: "tab", aria: { current: ("page" if finding_type == @finding_type) } do %>
        <%= finding_type.pluralize.capitalize %> <span class="count"><%= @current_counts[finding_type].values.sum %></span>
      <% end %>
    <% end %>
  </nav>

  <%= render(@finding_type ? "project_findings" : "project_overview") %>
</main>
