<section class="panel widespread">
  <div class="panel__head panel__head--stack">
    <h2>Most widespread vulnerabilities</h2>
    <span class="note">Current findings, by number of projects</span>
  </div>
  <% if @widespread.any? %>
    <ol class="list">
      <% @widespread.each do |row| %>
        <li>
          <span class="badge badge--<%= row.severity.downcase %>" title="<%= row.severity %>"><%= row.severity.first %></span>
          <span class="widespread__finding">
            <span class="mono"><%= report_link(row.identifier, row.primary_url) %></span>
            <span class="note mono"><%= row.packages.join(", ") %></span>
          </span>
          <span class="note"><b class="mono"><%= row.project_count %></b> <%= "project".pluralize(row.project_count) %></span>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="empty muted">No vulnerabilities in the current scans.</p>
  <% end %>
</section>
